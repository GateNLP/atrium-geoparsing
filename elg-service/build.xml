<project name="GATE IE tools" default="all" basedir="." xmlns:if="ant:if" xmlns:maven="antlib:org.eclipse.aether.ant">
  <description>Project to build service images for specific GATE services</description>

  <!-- Prevent Ant from warning about includeantruntime not being set -->
  <property name="build.sysclasspath" value="ignore" />

  <property name="build.dir" location="build" />
  <property name="template.dir" location="template" />

  <property name="dataset" value="unknown" />

  <!-- download a copy of aether ant tasks if we don't have them already
         NOTE: at some point switch to using Apache Maven Resolver for this -->
  <get src="http://search.maven.org/remotecontent?filepath=org/eclipse/aether/aether-ant-tasks/1.0.0.v20140518/aether-ant-tasks-1.0.0.v20140518-uber.jar" dest="aether-ant-tasks-uber.jar" verbose="true" skipexisting="true" />
  <fail message="Checksum mismatch for 'aether-ant-tasks-uber.jar'. Please delete it and rerun ant to redownload.">
    <condition>
      <not>
        <checksum file="aether-ant-tasks-uber.jar" algorithm="SHA" property="95dadd03392a75564904da45108cf048abe6e5bb" verifyproperty="checksum.matches" />
      </not>
    </condition>
  </fail>

  <path id="aether-ant-tasks.classpath" path="aether-ant-tasks-uber.jar" />
  <typedef resource="org/eclipse/aether/ant/antlib.xml" uri="antlib:org.eclipse.aether.ant" classpathref="aether-ant-tasks.classpath" />

  <!-- build the gate-core classpath via maven -->
  <maven:resolve>
    <maven:remoterepos>
      <maven:remoterepo url="http://repo.gate.ac.uk/content/groups/public/" id="gaterepo" releases="false" snapshots="true" updates="always" checksums="ignore" />
      <maven:remoterepo url="https://repo1.maven.org/maven2" id="central" releases="true" snapshots="false" updates="never" checksums="fail"/>
    </maven:remoterepos>
    <maven:dependencies>
      <maven:dependency groupid="uk.ac.gate" artifactid="gate-core" version="9.0-SNAPSHOT" />
    </maven:dependencies>
    <path refid="gate.runtime.classpath" classpath="runtime" />
  </maven:resolve>

  <typedef resource="gate/util/ant/antlib.xml"
           classpathref="gate.runtime.classpath" />

  <macrodef name="wrapRt">
    <attribute name="xgapp" />
    <sequential>
      <move file="@{xgapp}"
            tofile="@{xgapp}.plain" />
      <xslt style="utils/wrap-in-realtime.xsl"
            in="@{xgapp}.plain"
            out="@{xgapp}" />
      <delete file="@{xgapp}.plain" />
    </sequential>
  </macrodef>

  <macrodef name="pipeline">
    <attribute name="name" />
    <attribute name="xgapp" />
    <attribute name="copyResourceDirs" default="no" />
    <attribute name="wrapRt" default="true" />
    <attribute name="xmx" default="" />
    <element name="extracontent" optional="yes"/>
    <element name="packageadditions" optional="yes" />
    <sequential>
      <mkdir dir="${build.dir}/@{name}/application" />
      <packagegapp src="@{xgapp}"
                   destfile="${build.dir}/@{name}/application/application.xgapp"
                   copyResourceDirs="@{copyResourceDirs}"
                   mavenCache="${build.dir}/@{name}/application/maven-cache.gate"
                   copyPlugins="yes">
        <hint from="../application-resources" to="./application-resources" />
        <packageadditions/>
      </packagegapp>
      <wrapRt xgapp="${build.dir}/@{name}/application/application.xgapp" if:true="@{wrapRt}" />
      <condition property="@{name}.java.opts" value="" else="ENV JAVA_OPTS=-Xmx@{xmx}">
        <equals arg1="@{xmx}" arg2="" />
      </condition>
      <copy todir="${build.dir}/@{name}">
        <fileset file="template/Dockerfile" />
        <filterset>
          <filter token="java_opts" value="${@{name}.java.opts}" />
        </filterset>
      </copy>
      <mkdir dir="${build.dir}/@{name}/elg" />
      <copy todir="${build.dir}/@{name}/elg">
        <fileset file="template/application.yml"/>
      </copy>
      <!-- process .executables files to ensure execute permission where needed -->
      <exec dir="${build.dir}/@{name}/elg" executable="find">
        <arg value="." />
        <arg value="-name" />
        <arg value=".executables" />
        <arg value="-exec" />
        <arg value="sh" />
        <arg value="-c" />
        <arg value="cd `dirname {}` ; while read file ; do chmod +x $file ; done &lt; .executables" />
        <arg value=";" />
      </exec>
    </sequential>
  </macrodef>

  <target name="build">
    <pipeline name="atrium-geoparsing-${dataset}" xgapp="../application.xgapp" copyResourceDirs="yes" />
  </target>

</project>

